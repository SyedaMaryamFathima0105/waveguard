# Copy to .env and replace this placeholder with a random secret.
WAVEGUARD_SECRET_KEY=replace-with-a-random-64-character-hex-key

# Use true only when WaveGuard is served over HTTPS. Keep false for local HTTP.
WAVEGUARD_COOKIE_SECURE=false

# Optional; defaults to instance/waveguard.sqlite3.
# WAVEGUARD_DATABASE_PATH=instance/waveguard.sqlite3
